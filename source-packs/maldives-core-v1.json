{
  "pack": "maldives-core-v1",
  "description": "ARGUS Maldives core web source registry. Telegram and Viber remain on the Android notification collector.",
  "sources": [
    {
      "entityId": "mv-met",
      "name": "Maldives Meteorological Service",
      "platform": "web",
      "url": "https://meteorology.gov.mv/",
      "collector": "web",
      "sourceType": "weather",
      "region": "MV",
      "country": "MV",
      "languages": [
        "dv",
        "en"
      ],
      "priority": "P0",
      "reliability": "official",
      "tags": [
        "official",
        "emergency",
        "weather"
      ],
      "collectorConfig": {
        "mode": "web",
        "autoCollect": false,
        "bootstrapMode": "mark_seen",
        "pollIntervalSeconds": 120,
        "maxItemsPerPoll": 8,
        "discoveryUrl": "https://meteorology.gov.mv/news",
        "includeUrlPatterns": [
          "^https://(?:www\\.)?meteorology\\.gov\\.mv/(?:index\\.php/)?single-news/\\d+/?$"
        ],
        "excludeUrlPatterns": [
          "/downloads/",
          "/climate-data",
          "/about",
          "/contact",
          "/reach-us",
          "/forecast",
          "/aviation",
          "/awareness",
          "/active_alerts"
        ],
        "maxAgeHours": 720,
        "minCandidateScore": 4,
        "minArticleBodyLength": 120,
        "minArticleWords": 15
      },
      "notes": "Legacy MMS website/news collector retained for manual investigation only. Automatic collection disabled in favor of the official CAP alert feed."
    },
